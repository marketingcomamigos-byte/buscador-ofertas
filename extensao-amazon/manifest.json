{
  "manifest_version": 3,
  "name": "OFERTAS+ — Importador Amazon (V5.2 captura de imagem corrigida)",
  "version": "5.2.0",
  "description": "Detecta produto Amazon, captura link de associado e importa nome, preço, ASIN e imagem real para o OFERTAS+.",
  "minimum_chrome_version": "120",
  "permissions": [
    "clipboardRead",
    "offscreen",
    "storage",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "https://*.amazon.com.br/*",
    "https://*.amazon.com/*",
    "https://*.associates.amazon.com/*",
    "https://*.images-amazon.com/*",
    "https://*.media-amazon.com/*",
    "https://amazon.com.br/*",
    "https://buscador-ofertas-diario.vercel.app/*",
    "https://images-eu.ssl-images-amazon.com/*",
    "https://images-fe.ssl-images-amazon.com/*",
    "https://images-na.ssl-images-amazon.com/*",
    "https://images.amazon.com/*",
    "https://m.media-amazon.com/*",
    "https://www.amazon.com.br/*"
  ],
  "action": {
    "default_title": "Salvar Amazon no OFERTAS+",
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icons/logo-512.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.com.br/*",
        "https://amazon.com.br/*",
        "https://*.amazon.com.br/*",
        "https://www.amazon.com/*",
        "https://amazon.com/*",
        "https://*.amazon.com/*",
        "https://*.associates.amazon.com/*"
      ],
      "js": [
        "amazon-main-bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.amazon.com.br/*",
        "https://amazon.com.br/*",
        "https://*.amazon.com.br/*",
        "https://www.amazon.com/*",
        "https://amazon.com/*",
        "https://*.amazon.com/*",
        "https://*.associates.amazon.com/*"
      ],
      "js": [
        "amazon-content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://buscador-ofertas-diario.vercel.app/admin.html*"
      ],
      "js": [
        "site-connect.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
